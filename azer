            const name = document.getElementById('abc_name').value;
            const usage = parseFloat(document.getElementById('abc_usage').value);
            const cost = parseFloat(document.getElementById('abc_cost').value);

            if(name && usage && cost) {
                abcItems.push({name, usage, cost, value: usage * cost});
                updateAbcTable();
                // Clear inputs
                document.getElementById('abc_name').value = '';
                document.getElementById('abc_usage').value = '';
                document.getElementById('abc_cost').value = '';
            }
        }

        function updateAbcTable() {
            // Sort Descending
            abcItems.sort((a, b) => b.value - a.value);
            const totalVal = abcItems.reduce((sum, item) => sum + item.value, 0);
            document.getElementById('abc-grand-total').innerText = "الإجمالي: " + totalVal.toLocaleString();

            let cumSum = 0;
            const tbody = document.getElementById('abc-table-body');
            tbody.innerHTML = '';

            abcItems.forEach(item => {
                cumSum += item.value;
                const cumPct = (cumSum / totalVal) * 100;
                let cat = 'C';
                let color = 'text-gray-500 bg-gray-100';
                
                if(cumPct <= 75) { cat = 'A'; color = 'text-emerald-700 bg-emerald-100'; }
                else if(cumPct <= 95) { cat = 'B'; color = 'text-amber-700 bg-amber-100'; }

                tbody.innerHTML += `
                    <tr class="border-b hover:bg-gray-50">
                        <td class="py-2 px-2 font-medium">${item.name}</td>
                        <td class="py-2 px-2">${item.usage}</td>
                        <td class="py-2 px-2">${item.cost}</td>
                        <td class="py-2 px-2 font-bold">${item.value.toLocaleString()}</td>
                        <td class="py-2 px-2 text-xs text-gray-500">${cumPct.toFixed(1)}%</td>
                        <td class="py-2 px-2"><span class="px-2 py-0.5 rounded text-xs font-bold ${color}">${cat}</span></td>
                        <td class="py-2 px-2 text-center"><button class="text-red-400 hover:text-red-600" onclick="removeAbcItem('${item.name}')">×</button></td>
                    </tr>
                `;
            });
            updateAbcStats(totalVal);
        }

        function removeAbcItem(name) {
