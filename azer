        // B. Inventory
        function calcInventory() {
            const D = parseFloat(document.getElementById('inv_demand').value);
            const S = parseFloat(document.getElementById('inv_orderCost').value);
            const H = parseFloat(document.getElementById('inv_holdingCost').value);
            const d = parseFloat(document.getElementById('inv_dailyDemand').value);
            const L = parseFloat(document.getElementById('inv_leadTime').value);
            const SS = parseFloat(document.getElementById('inv_safety').value) || 0;

            if(D && S && H) {
                const eoq = Math.sqrt((2 * D * S) / H);
                const rop = (d * L) + SS;
                const orders = D / eoq;
                const totalOrderCost = orders * S;
                const totalHoldingCost = (eoq / 2) * H; // Ignoring SS holding cost for basic model or adding it: ((eoq/2) + SS) * H

                document.getElementById('res_eoq').innerText = Math.round(eoq);
                document.getElementById('res_rop').innerText = Math.round(rop);
                document.getElementById('res_orders').innerText = orders.toFixed(1);
                document.getElementById('res_cost_order').innerText = Math.round(totalOrderCost).toLocaleString();
                document.getElementById('res_cost_holding').innerText = Math.round(totalHoldingCost).toLocaleString();
                document.getElementById('res_total_inv').innerText = Math.round(totalOrderCost + totalHoldingCost).toLocaleString();
            }
        }

