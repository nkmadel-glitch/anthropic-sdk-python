        function calcBaumol() {
            const T = parseFloat(document.getElementById('bau_need').value);
            const b = parseFloat(document.getElementById('bau_cost').value);
            const i = parseFloat(document.getElementById('bau_opp').value) / 100;

            if(T && b && i) {
                const C = Math.sqrt((2 * T * b) / i);
                document.getElementById('res_bau_cash').innerText = Math.round(C).toLocaleString();
                document.getElementById('res_bau_trans').innerText = Math.ceil(T / C);
                document.getElementById('res_bau_total').innerText = Math.round((T/C)*b + (C/2)*i).toLocaleString();
            }
        }

        function calcMiller() {
            const b = parseFloat(document.getElementById('mil_trans').value);
            const sig2 = parseFloat(document.getElementById('mil_variance').value);
            const i = parseFloat(document.getElementById('mil_rate').value) / 100; // Daily rate
            const L = parseFloat(document.getElementById('mil_lower').value);

            if(b && sig2 && i && L) {
                const Z = Math.cbrt((3 * b * sig2) / (4 * i)) + L;
                const H = (3 * Z) - (2 * L);
                
                document.getElementById('res_mil_z').innerText = Math.round(Z).toLocaleString();
                document.getElementById('res_mil_h').innerText = Math.round(H).toLocaleString();
                document.getElementById('res_mil_l').innerText = L.toLocaleString();
            }
        }

        // E. Financing Costs
        function calcTradeCredit() {
            const d = parseFloat(document.getElementById('fc_tc_disc').value) / 100;
            const dp = parseFloat(document.getElementById('fc_tc_dperiod').value);
            const cp = parseFloat(document.getElementById('fc_tc_cperiod').value);
            
            if(d && cp > dp) {
                const cost = (d / (1 - d)) * (360 / (cp - dp));
                document.getElementById('res_tc_cost').innerText = (cost * 100).toFixed(2) + '%';
            }
        }

        function calcBankCost() {
            const r = parseFloat(document.getElementById('fc_bc_rate').value) / 100;
            const b = parseFloat(document.getElementById('fc_bc_comp').value) / 100 || 0;
            if(r) {
                const eff = r / (1 - b);
                document.getElementById('res_bc_cost').innerText = (eff * 100).toFixed(2) + '%';
            }
        }

        function calcBondCost() {
             // Simplified YTM approx or just After-tax cost
             const face = parseFloat(document.getElementById('fc_bd_face').value);
             const rate = parseFloat(document.getElementById('fc_bd_rate_pct').value) / 100;
             const price = parseFloat(document.getElementById('fc_bd_price').value);
             const float = parseFloat(document.getElementById('fc_bd_float').value) || 0;
             const years = parseFloat(document.getElementById('fc_bd_years').value);
             const tax = parseFloat(document.getElementById('fc_tax_rate').value) / 100 || 0;

             if(face && price && years) {
                 const netP = price - float;
                 document.getElementById('fc_bd_net').value = netP;
                 const I = face * rate;
                 // Approximate YTM = (I + (Face - NetP)/n) / ((Face + NetP)/2)
                 const approxYTM = (I + (face - netP)/years) / ((face + netP)/2);
                 const afterTax = approxYTM * (1 - tax);
                 document.getElementById('res_bd_cost').innerText = (afterTax * 100).toFixed(2) + '%';
             }
        }

        function generateAmortizationSchedule() {
            document.getElementById('amortization-container').classList.remove('hidden');
            // Simplified logic just to show functionality
            const body = document.getElementById('amortization-body');
            body.innerHTML = `<tr><td colspan="6" class="p-2 text-gray-500">تم إنشاء الجدول بنجاح (بيانات تجريبية)</td></tr>`;
        }

        // F. Lease Vs Buy
        function calcLeaseVsBuy() {
            // Inputs
            const cost = parseFloat(document.getElementById('fc_ls_asset').value);
            const life = parseFloat(document.getElementById('fc_ls_life').value);
            // Buy Side
            const loanRate = parseFloat(document.getElementById('fc_ls_loan_rate').value) / 100;
            const tax = parseFloat(document.getElementById('fc_ls_tax').value) / 100;
            // Lease Side
            const leasePmt = parseFloat(document.getElementById('fc_ls_payment').value);
            const discount = parseFloat(document.getElementById('fc_ls_discount').value) / 100;

            if(!cost || !life || !leasePmt || !discount) return;

            // Simplified Calculations (Linear Depr, Simple Discounting)
            // 1. Cost of Leasing (PV of Payments * (1-T))
            // Assuming payments at start of year (Annuity Due)
            let pvLease = 0;
            const afterTaxLease = leasePmt * (1 - tax);
            
            // PV Annuity Due factor
            // For i=0 to n-1: 1/(1+r)^i
            for(let i=0; i<life; i++) {
                pvLease += afterTaxLease / Math.pow(1 + discount, i);
            }

            // 2. Cost of Buying
            // PV(Loan Pmt) - PV(Tax Shield Depr)
            // Let's assume cash purchase for simplicity to compare Pure Lease vs Pure Buy
            // Cost of Asset - PV(Tax Shield)
            const depr = cost / life;
            const taxShield = depr * tax;
            let pvShield = 0;
            // Shield is at end of year usually
            for(let i=1; i<=life; i++) {
                pvShield += taxShield / Math.pow(1 + discount, i);
            }
            const pvBuy = cost - pvShield;

            // Update UI
            document.getElementById('val-buy-pv').innerText = Math.round(pvBuy).toLocaleString();
            document.getElementById('val-lease-pv').innerText = Math.round(pvLease).toLocaleString();
            
            const diff = pvBuy - pvLease; // Positive means Buy is more expensive -> Lease is better
            const nalSpan = document.getElementById('val-nal');
            const badge = document.getElementById('decision-badge');

            nalSpan.innerText = Math.round(Math.abs(diff)).toLocaleString();

            const barBuy = document.getElementById('bar-buy-height');
            const barLease = document.getElementById('bar-lease-height');
            
            // Normalize heights for UI (max 100%)
            const max = Math.max(pvBuy, pvLease) * 1.2;
            barBuy.style.height = (pvBuy/max)*100 + '%';
            barLease.style.height = (pvLease/max)*100 + '%';

            if(diff > 0) {
                // Lease is cheaper
                badge.innerText = "قرار: الاستئجار أفضل";
                badge.classList.remove('bg-gray-400', 'bg-blue-500');
                badge.classList.add('bg-purple-600');
                document.getElementById('nal-bar').style.backgroundColor = '#9333ea'; // purple
            } else {
                // Buy is cheaper
                badge.innerText = "قرار: الشراء أفضل";
                badge.classList.remove('bg-gray-400', 'bg-purple-600');
                badge.classList.add('bg-blue-600');
                document.getElementById('nal-bar').style.backgroundColor = '#2563eb'; // blue
            }
        }

        // G. Valuation
        function calcValuation() {
            // CAPM
            const rf = parseFloat(document.getElementById('capm_rf').value);
            const rm = parseFloat(document.getElementById('capm_rm').value);
            const beta = parseFloat(document.getElementById('capm_beta').value);
            
            if(rf && rm && beta) {
                const ke = rf + beta * (rm - rf);
                document.getElementById('res_capm').innerText = ke.toFixed(2) + '%';
                // Auto-fill WACC Ke if empty
                if(!document.getElementById('wacc_ke').value) document.getElementById('wacc_ke').value = ke.toFixed(2);
            }

            // WACC
            const wd = parseFloat(document.getElementById('wacc_wd').value) / 100;
            const rd = parseFloat(document.getElementById('wacc_rd').value) / 100;
            const we = parseFloat(document.getElementById('wacc_we').value) / 100;
            const ke_w = parseFloat(document.getElementById('wacc_ke').value) / 100;
            const t = parseFloat(document.getElementById('wacc_tax').value) / 100;

            if(wd && rd && we && ke_w) {
                // WACC = Wd*Rd*(1-t) + We*Ke
                const wacc = (wd * rd * (1 - (t || 0))) + (we * ke_w);
                document.getElementById('res_wacc').innerText = (wacc * 100).toFixed(2) + '%';
            }
        }

        // H. Budgets
        function updateBudget() {
            const inputs = document.querySelectorAll('.bd-input');
            const data = { in: [], out: [] };
            let init = parseFloat(document.querySelector('[data-row="init"]').value) || 0;

            inputs.forEach(inp => {
                const r = inp.dataset.row;
                const c = parseInt(inp.dataset.col);
                const val = parseFloat(inp.value) || 0;
                if(r === 'in') data.in[c] = val;
                if(r === 'out') data.out[c] = val;
            });

            for(let i=0; i<6; i++) {
                // Set initial for this month
                if(i > 0) {
                    const prevEnd = parseFloat(document.getElementById(`bd-end-${i-1}`).innerText.replace(/,/g,''));
                    document.getElementById(`bd-init-${i}`).innerText = prevEnd.toLocaleString();
                    init = prevEnd; // Current init is previous end
                }
                
                const income = data.in[i] || 0;
                const expense = data.out[i] || 0;
                const end = init + income - expense;
                
                document.getElementById(`bd-end-${i}`).innerText = end.toLocaleString();
            }
        }
        
        // Initialize budget listener
        document.querySelectorAll('.bd-input').forEach(input => {
            input.addEventListener('input', updateBudget);
        });

    </script>
