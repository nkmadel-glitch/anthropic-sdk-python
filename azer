        function calculatePolicyResults() {
            const baseP = parseFloat(document.getElementById('cp_price').value);
            const baseU = parseFloat(document.getElementById('cp_baseUnits').value);
            const varC = parseFloat(document.getElementById('cp_varCost').value);
            const roi = parseFloat(document.getElementById('cp_roi').value) / 100;

            const tbody = document.getElementById('policy-results-body');
            tbody.innerHTML = '';
            let bestPolicy = null;
            let maxProfit = -Infinity;

            // Calculate Base Scenario (Current)
            // Ideally we compare incrementals, but let's calculate Net Profit for each
            
            creditPolicies.forEach(p => {
                const newUnits = baseU * (1 + p.growth / 100);
                const sales = newUnits * baseP;
                const variableCosts = newUnits * varC;
                const contribution = sales - variableCosts;
                
                const badDebtVal = sales * (p.badDebt / 100);
                const discountVal = sales * (p.discUsage / 100) * (p.discRate / 100);
                
                // Opportunity Cost: (Variable Cost per unit * Units * Collection Period / 360) * ROI
                // Note: More accurate is usually Avg Receivables at Cost * ROI
                const avgRecCost = (newUnits * varC) * (p.collection / 360); 
                const oppCost = avgRecCost * roi;

                const netBenefit = contribution - p.fixedCost - badDebtVal - discountVal - oppCost;

                if(netBenefit > maxProfit) {
                    maxProfit = netBenefit;
                    bestPolicy = p;
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-4 py-3 font-medium text-slate-800">${p.name}</td>
                        <td class="px-4 py-3 text-emerald-600 font-bold">+${Math.round(contribution).toLocaleString()}</td>
                        <td class="px-4 py-3 text-red-400">-${Math.round(badDebtVal).toLocaleString()}</td>
                        <td class="px-4 py-3 text-red-400">-${Math.round(oppCost).toLocaleString()}</td>
                        <td class="px-4 py-3 text-red-400">-${Math.round(discountVal).toLocaleString()}</td>
                        <td class="px-4 py-3 text-red-400">-${Math.round(p.fixedCost).toLocaleString()}</td>
                        <td class="px-4 py-3 font-black text-slate-900 bg-slate-100">${Math.round(netBenefit).toLocaleString()}</td>
                    </tr>
                `;
            });

            document.getElementById('policy-results').classList.remove('hidden');
            if(bestPolicy) {
                document.getElementById('winner-banner').innerHTML = `
                    <div><div class="text-xs text-slate-300 uppercase mb-1">السياسة الأفضل</div><div class="text-2xl font-bold">${bestPolicy.name}</div></div>
                    <div class="text-right"><div class="text-xs text-slate-300">الصافي المتوقع</div><div class="text-3xl font-bold text-emerald-400">${Math.round(maxProfit).toLocaleString()} د.ج</div></div>
                `;
            }
        }

